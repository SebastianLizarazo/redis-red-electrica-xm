# Imagen del Subscriber / Processor (T-INFRA-009).
#
# Como el publisher, solo depende de `common/`. Consume el canal Pub/Sub
# `energy-events`, calcula las métricas derivadas y evalúa las alertas.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY common/ ./common/
COPY subscriber/ ./subscriber/

RUN pip install --no-cache-dir .

RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

# Misma limitación que en el publisher: verifica conectividad con Redis,
# no que el bucle de consumo siga vivo.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os,redis; redis.Redis.from_url(os.environ['REDIS_URL']).ping()"

CMD ["python", "-m", "subscriber.main"]
