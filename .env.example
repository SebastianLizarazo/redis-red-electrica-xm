# redis-red-electrica-xm — variables de entorno de ejemplo.
#
# Copia este archivo a `.env` y ajusta los valores para tu entorno local.
# `.env` está ignorado por git (ver `.gitignore`).
#
# Convención: las claves en MAYÚSCULAS_SNAKE_CASE. Las defaults razonables
# permiten arrancar el sistema en modo simulador sin tocar nada.

# --- Redis -------------------------------------------------------------------
# URL completa de Redis. En docker-compose el hostname es `redis` (nombre del
# servicio); en local, normalmente `localhost`.
REDIS_URL=redis://localhost:6379/0

# Puerto del HOST al que se publica el Redis de docker compose. Solo afecta
# al mapeo de puertos: dentro de la red los servicios siguen hablando por el
# 6379. Cámbialo si ya tienes un Redis instalado en tu máquina y `make up`
# falla con "address already in use".
REDIS_PORT=6379

# --- API XM (datos reales) ----------------------------------------------------
# Endpoint principal de Demanda en Tiempo Real de XM (sin autenticación).
# Fuente: https://serviciosfacturacion.xm.com.co/
XM_DEMANDA_URL=https://serviciosfacturacion.xm.com.co/XM.Portal.Indicadores/api/Operacion/DemandaTiempoReal

# Timeout HTTP estricto en segundos. Más de esto cuenta como fallo.
XM_TIMEOUT_SECONDS=10

# Activar enriquecimiento con pydataxm (Generación por recurso, SINERGOX).
# Coste: agrega latencia y depende de XM-SINERGOX no estar caído.
XM_USE_PYDATAXM=0

# Forzar fuente: vacio = automático (real→simulador tras 3 fallos).
# Valores válidos: real | simulator | (vacío).
FORCE_SOURCE=

# --- Publisher (cadencia) -----------------------------------------------------
# Modo simulador: cada 5 segundos (ideal para demo). Cumple literalmente
# el "cada 5/10/15 segundos" del doc del taller.
PUBLISHER_INTERVAL_SECONDS=5

# Modo real: cada 5 minutos (ritmo natural de la API XM DemandaTiempoReal).
# Acelerar artificialmente repite el mismo valor y no aporta.
PUBLISHER_INTERVAL_SECONDS_REAL=300

# --- Backend FastAPI ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard ---------------------------------------------------------------
# URL base del backend que consume el frontend. En dev local es
# http://localhost:8000; en deploy vía GH Pages apuntaría al tunnel.
VITE_API_URL=http://localhost:8000

# Puerto del host para el dashboard cuando corre dentro de docker compose
# (`make up-dev`). Igual que REDIS_PORT, solo mueve el mapeo.
DASHBOARD_PORT=5173

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# Si está en 1, fuerza JSON estructurado; 0 = texto plano (más legible en dev).
LOG_JSON=0

# --- Alertas -----------------------------------------------------------------
# Umbral del déficit demanda-generación (MW) que dispara Alerta 1 (alta).
DEMAND_GENERATION_GAP_THRESHOLD=800.0
# Umbral de % renovable bajo el que dispara Alerta 2 (media).
RENEWABLE_THRESHOLD=30.0
# Ciclos consecutivos para confirmar la alerta (debounce).
ALERT_DEBOUNCE_CYCLES=2

# --- Zonas por defecto --------------------------------------------------------
# OPEN-1 del design: las 5 zonas colombianas representativas. Si más adelante
# el equipo decide cambiarlas (ej. CAR/QUI/ARA/RIS/MAG), basta editar aquí
# o setear DEFAULT_ZONES en el .env.
DEFAULT_ZONES=ANT,VAL,ATL,BOG,SAN

# --- Misc ---------------------------------------------------------------------
STALE_THRESHOLD_SECONDS=900
